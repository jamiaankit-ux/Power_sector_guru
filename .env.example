# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/power_academy"
AUTH_SECRET="change-me-to-a-long-random-string-in-production"
APP_URL="http://localhost:3000"

# First admin account (created on first setup if no admin exists)
ADMIN_EMAIL="you@example.com"
ADMIN_PHONE=""
ADMIN_PASSWORD=""
# Set to "false" on a live site so no demo learner, activity or review is created
SEED_DEMO_LEARNER="true"

# Payments: mock | razorpay | stripe
PAYMENT_PROVIDER="mock"
# Test payments unlock paid courses without money; keep "false" on a live site
ALLOW_TEST_PAYMENTS="false"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
STRIPE_SECRET_KEY=""
# GST included in prices, in percent (0 to disable)
TAX_PERCENT="18"

# OTP delivery: console | msg91 | twilio (SMS), console | resend (email).
# With "console" on a live site, OTP login is hidden and password login is used.
SMS_PROVIDER="console"
EMAIL_PROVIDER="console"
